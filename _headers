# A HTML mindig revalidáljon, hogy a friss deploy azonnal látszódjon
# (fontos az iPados "Kezdőképernyőre" hozzáadott PWA-nál is).
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/manifest.json
  Cache-Control: no-cache, must-revalidate

# Az ikonok tartalma ritkán/soha nem változik, ezekre maradhat hosszú cache.
/icon-180.png
  Cache-Control: public, max-age=31536000, immutable

/icon-512.png
  Cache-Control: public, max-age=31536000, immutable
